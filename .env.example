FIP_APP_VERSION=1.0.6
FIP_IMAGE_REPOSITORY=keepalived
# Obligatorio en deploy real: copiar el sha256 publicado por la release verificada.
FIP_IMAGE_DIGEST=
FIP_CONTAINER_NAME=Keepalived
SOURCE_URL=https://github.com/Ezr43l/keepalived-s
LICENSE_SPDX=Apache-2.0

# Debe personalizarse en cada nodo.
FIP_NODO=node-a
FIP_NODOS=node-a:192.0.2.10:eth0:150,node-b:192.0.2.11:eth0:100
FIP_PARES=http://192.0.2.11:6060
FIP_PUERTO=6060
# Contrato fijo de red de la versión 1.0.2.
FIP_VIP_PREFIX=24
FIP_RETARDO=45
FIP_DATA_DIR=./data

# Cree estos tres ficheros en un árbol hermano dedicado, nunca dentro de FIP_DATA_DIR.
FIP_VRRP_AUTH_FILE=../floating-ip-secrets/keepalived-vrrp.txt
FIP_SESSION_SECRET_FILE=../floating-ip-secrets/keepalived-session-secret.txt
FIP_CLUSTER_TOKEN_FILE=../floating-ip-secrets/keepalived-cluster-token.txt

FIP_SESSION_HOURS=12
FIP_COOKIE_SECURE=0
FIP_TOTP_ISSUER=Keepalived
